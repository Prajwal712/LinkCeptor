# ═══════════════════════════════════════════════════════════
#  Smart Link Interceptor — Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Threat Intelligence (Concurrent Scanners) ────────
# VirusTotal: https://www.virustotal.com/gui/my-apikey (free: 4 req/min)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing: https://console.cloud.google.com/apis/credentials
# Enable "Safe Browsing API" in your Google Cloud project first
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# ─── Server ────────────────────────────────────────────
PORT=3001

# ─── Redis (Optional for local, required for Docker) ──
# If not set, the server falls back to an in-memory cache.
# REDIS_URL=redis://localhost:6379

# ─── Cache TTL ─────────────────────────────────────────
# How long to cache URL verdicts (in seconds). Default: 24 hours.
CACHE_TTL=86400

# ─── Cluster Mode ─────────────────────────────────────
# Number of worker processes. Set to 0 for auto (= CPU cores).
# Only used when running `node cluster.js`
# CLUSTER_WORKERS=0
